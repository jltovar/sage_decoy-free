{
  "schema_version": 1,
  "name": "public_validation_development",
  "dataset_id": "public_validation_dataset",
  "search_config": "/path/to/base_search.json",
  "target_fasta": "/path/to/target.fasta",
  "spectra": [
    "/path/to/development_01.mzML",
    "/path/to/development_02.mzML"
  ],
  "output_root": "/path/to/native_workflow/development",
  "candidate_pool_root": null,
  "annotation_cache_root": null,
  "target_only_annotation_cache_root": null,
  "require_existing_candidate_pool": false,
  "require_existing_annotation_cache": false,
  "migrate_schema_v2_annotation_cache_only": false,
  "target_only_calibration_policy": "refit_with_locked_window",
  "entrapment": {
    "database_mode": "native_generated",
    "foreign_fastas": [
      "/path/to/foreign_species_1.fasta",
    "/path/to/foreign_species_2.fasta"
  ],
  "foreign_source_mode": "automatic",
  "shared_peptide_exclusion_mode": "sage_search_space",
    "output_fasta": "/path/to/native_workflow/development/target_foreign_entrapment.fasta",
    "partition_artifact": null,
    "seed": 42,
    "protein_fold": 1
  },
  "models": [
    {
      "model": "moments",
      "ensemble_interaction_baseline": true,
      "window_optimizer": {
        "strategy": "landscape_adaptive",
        "min_rank_range": [2, 10],
        "max_rank_range": [2, 25]
      },
      "ms2rescore": "measure"
    },
    {
      "model": "mle",
      "ensemble_interaction_baseline": true,
      "window_optimizer": {
        "strategy": "landscape_adaptive",
        "min_rank_range": [2, 10],
        "max_rank_range": [2, 25]
      },
      "ms2rescore": "measure"
    },
    {
      "model": "lower_order",
      "ensemble_participation": "auto",
      "target_only_calibration_policy": "refit_with_locked_window",
      "ensemble_interaction_baseline": false,
      "window_optimizer": {
        "strategy": "landscape_adaptive",
        "min_rank_range": [2, 10],
        "max_rank_range": [2, 25]
      },
      "ms2rescore": "measure"
    },
    {
      "model": "msfdr",
      "ensemble_participation": "auto",
      "ensemble_interaction_baseline": false,
      "window_optimizer": {
        "strategy": "landscape_adaptive",
        "min_rank_range": [2, 10],
        "max_rank_range": [2, 25]
      },
      "ms2rescore": "measure"
    },
    {
      "model": "msfdr1_smix",
      "ensemble_interaction_baseline": true,
      "ms2rescore": "measure"
    },
    {
      "model": "msfdr2_smix",
      "ensemble_participation": "auto",
      "ensemble_interaction_baseline": false,
      "window_optimizer": {
        "strategy": "landscape_adaptive",
        "min_rank_range": [2, 10],
        "max_rank_range": [2, 25]
      },
      "ms2rescore": "measure"
    },
    {
      "model": "nokoi",
      "ensemble_participation": "auto",
      "ensemble_interaction_baseline": false,
      "window_optimizer": {
        "strategy": "landscape_adaptive",
        "min_rank_range": [2, 10],
        "max_rank_range": [2, 25]
      },
      "ms2rescore": "measure"
    },
    {
      "model": "ensemble",
      "ms2rescore": "measure"
    }
  ],
  "baseline": {
    "paths": [
      "/path/to/frozen_reference_results"
    ],
    "output_manifest": "/path/to/native_workflow/development/baseline.manifest.json",
    "status": "corrected_complete"
  },
  "validation": {
    "null_window_validation_scope": "level4",
    "use_generated_entrapment_ratios": true,
    "fdr_threshold": 0.01,
    "maximum_transfer_fraction_loss": 0.20,
    "minimum_incremental_ensemble_peptides": 1,
    "minimum_ensemble_experts": 2,
    "minimum_entrapment_peptides_for_stable_estimate": 3,
    "maximum_parity_fraction_difference": 0.001,
    "tdc_reference_method": "tdc_reference",
    "dataset_role": "development",
    "diagnostic_only": false,
    "parity_pairs": [
      {
        "baseline_method": "baseline_moments",
        "native_method": "moments"
      }
    ],
    "additional_runs": [
      {
        "method": "baseline_moments",
        "stage": "optimized",
        "results": "/path/to/frozen_reference_results/results.sage.tsv",
        "mode": "decoy_free",
        "expected_search_space": "+Ent"
      },
      {
        "method": "tdc_reference",
        "stage": "optimized",
        "results": "/path/to/tdc_reference/results.sage.tsv",
        "mode": "tdc",
        "expected_search_space": "+Ent"
      }
    ]
  },
  "resume": true,
  "annotate_target_matches": true,
  "ensemble_lock": null,
  "locked_expert_artifacts": {},
  "artifact_reuse_policy": "dataset_local_only",
  "parameter_optimizer": {
    "schema_version": 4,
    "enabled": false,
    "classification": "development_only",
    "selected_experts": [
      "moments", "mle", "lower_order", "msfdr",
      "msfdr1_smix", "msfdr2_smix", "nokoi", "ensemble"
    ],
    "expected_expert_configuration_sha256": {},
    "frozen_expert_configuration_artifact": null,
    "require_expected_expert_configurations": false,
    "compiled_defaults": {},
    "workflow_defaults": {
      "psm_q_method": "storey",
      "peptide_q_method": "storey",
      "protein_q_method": "storey"
    },
    "fixed_baseline_values": {},
    "seed": 42,
    "maximum_trial_budget": 32,
    "maximum_optimization_passes": 2,
    "objective": [
      {"metric": "level4_proteins", "direction": "maximize"},
      {"metric": "level4_canonical_peptides", "direction": "maximize"},
      {"metric": "level4_peptidoforms", "direction": "maximize"},
      {"metric": "level4_psms", "direction": "maximize"},
      {"metric": "adjusted_entrapment_fdp", "direction": "minimize"},
      {"metric": "model_complexity", "direction": "minimize"},
      {"metric": "deterministic_parameter_order", "direction": "minimize"}
    ],
    "fixed_evaluation_threshold": 0.01,
    "empirical_entrapment_constraints": [
      {
        "level": "protein",
        "maximum_adjusted_fdp": 0.01,
        "minimum_entrapment_observations_for_power": 3
      }
    ],
    "underpowered_trial_policy": "not_evaluable",
    "entrapment_validation": {
      "mode": "full_population_development",
      "partition_schema_version": 1,
      "seed": 42,
      "salt": "",
      "selection_fraction": 0.5,
      "audit_fraction": 0.5,
      "require_existing_partition": false
    },
    "statistical_validity_contracts": {},
    "resume": true,
    "materialize_winner": true,
    "execution_mode": "optimization_and_post_selection",
    "implementation_smoke_only": false,
    "production_smoke_only": false,
    "require_existing_candidate_pool": true,
    "require_existing_raw_annotation_cache": true,
    "target_only_outcomes_excluded": true,
    "block_order": ["moments_model", "mle_model"],
    "blocks": [
      {
        "id": "moments_model",
        "enabled": true,
        "scope": "per_expert",
        "expert": "moments",
        "strategy": "exhaustive_grid",
        "structural_comparison": true,
        "fixed": {},
        "space": {
          "moments_robust_fit": [false, true],
          "moments_winsor_upper_q": [0.9, 0.95]
        },
        "window_search": {
          "strategy": "landscape_adaptive",
          "min_rank_range": [2, 10],
          "max_rank_range": [2, 25]
        },
        "use_external_features": false,
        "max_trials": 4
      },
      {
        "id": "mle_model",
        "enabled": true,
        "scope": "per_expert",
        "expert": "mle",
        "strategy": "staged_coordinate",
        "structural_comparison": false,
        "fixed": {},
        "space": {
          "mle_purification_factor": [0.1, 0.25, 0.35]
        },
        "window_search": {
          "strategy": "landscape_adaptive",
          "min_rank_range": [2, 10],
          "max_rank_range": [2, 25]
        },
        "use_external_features": true,
        "max_trials": 6,
        "max_passes": 2
      }
    ]
  }
}
